<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WasapiCapture/WasapiOut are obsolete in NAudio 3.x in favor of the new
         WasapiRecorderBuilder/WasapiPlayerBuilder APIs. That's a genuine API
         rewrite (different construction and capture model), out of scope for
         this migration — suppressed rather than silently ignored. -->
    <NoWarn>CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives in a subdirectory; without this exclusion the
         default SDK glob would compile NoelMic.Tests' own .cs files (and its
         xunit references) straight into this project. -->
    <Compile Remove="NoelMic.Tests\**" />
    <EmbeddedResource Remove="NoelMic.Tests\**" />
    <None Remove="NoelMic.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="NAudio.Wasapi" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets NoelMic.Tests exercise internal test seams (e.g. MouseHook.IsToggleButton)
         without widening those members to public. -->
    <InternalsVisibleTo Include="NoelMic.Tests" />
  </ItemGroup>

</Project>
